#include "constants/colosseum_cs01.h"

const LOCALID_WILLIE = 1
const LOCALID_SIGN = 2

mapscripts OutskirtStand_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: OutskirtStand_OnTransition
}

script OutskirtStand_OnTransition {
    if (flag(FLAG_TEMP_18) || flag(FLAG_COLO_CS01_WILLIE_CLEARED)) {
        clearflag(FLAG_TEMP_19)
    } else {
        setflag(FLAG_TEMP_19)
    }
    end
}

script OutskirtStand_EventScript_Willie {
    lock
    faceplayer

    if (!flag(FLAG_TEMP_18)) {
        msgbox(OutskirtStand_Text_WillieNotReady)
        release
        end
    }

    if (!flag(FLAG_COLO_CS01_WILLIE_CLEARED)) {
        msgbox(OutskirtStand_Text_WillieBattleStub)
        setflag(FLAG_COLO_CS01_WILLIE_CLEARED)
        setvar(VAR_COLO_CS01_CONTENT_STEP, COLO_CS01_STEP_WILLIE_CLEARED)
        special(ColoContent_ApplyStep)
    }

    msgbox(OutskirtStand_Text_WillieAfterBattle)
    release
    end
}

script OutskirtStand_EventScript_Sign {
    lock
    msgbox(OutskirtStand_Text_Sign)
    release
    end
}

text OutskirtStand_Text_WillieNotReady {
    format("The stand is quiet for the moment.\nNo one is waiting outside yet.")
}

text OutskirtStand_Text_WillieBattleStub {
    format("Willie steps out from the stand and sizes you up.\nHis first live outside battle still needs trainer data in this repo pass.")
}

text OutskirtStand_Text_WillieAfterBattle {
    format("Not bad.\nIf you're looking for a real destination, head for Phenac City next.")
}

text OutskirtStand_Text_Sign {
    format("OUTSKIRT STAND")
}
